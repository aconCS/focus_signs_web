# Copy to .env.local for local development. In Vercel, set these under
# Project Settings → Environment Variables instead — this file holds no
# real secrets and is safe to commit.
#
# Both values come from the GitHub OAuth App at
# https://github.com/settings/developers — see content/README.md.

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional — defaults to aconCS/focus_signs_web if unset.
# GITHUB_REPO=owner/repo
